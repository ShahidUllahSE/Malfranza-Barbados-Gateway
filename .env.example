VITE_API_URL=http://localhost:5000/api/v1

# Browser Maps key (used on localhost in dev). Must allow HTTP referrers:
#   http://localhost:8080/*
#   http://127.0.0.1:8080/*
# Enable: Maps JavaScript API + Places API (New)
VITE_GOOGLE_MAPS_API_KEY=replace-with-browser-key

# Optional aliases
VITE_MAP_KEYS=replace-with-browser-key
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_BROWSER_KEY=replace-with-lovable-browser-key
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_TRACKING_ID=replace-with-tracking-id

# PayPal Sandbox Client ID only (never the Secret)
VITE_PAYPAL_CLIENT_ID=replace-with-sandbox-client-id
